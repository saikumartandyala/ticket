# ============================================================
# LastMinutePass — Environment Variables Configuration
# ============================================================

# Database (PostgreSQL / Local SQLite fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/lastminutepass
# DATABASE_URL=sqlite+aiosqlite:///./lastminutepass.db

# Caching & Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Security (JWT configuration)
SECRET_KEY=  # required: python -c "import secrets; print(secrets.token_urlsafe(48))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 1 week

# Search Engine (MeiliSearch)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=meilimasterkey12345

# Third-party Integrations (Optional for local development)
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@lastminutepass.in
S3_BUCKET_NAME=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Admin console login (created on API startup). Use a strong password (8+ chars).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
ADMIN_NAME=TickOrbit Admin

# Timezone for user-entered dates/times (departures). All timestamps are stored in UTC.
APP_TIMEZONE=Asia/Kolkata
# Terminal log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---- Security / HTTPS ----
# development | production  (production: HSTS on, /docs off, refuses weak SECRET_KEY / mock OTP)
ENVIRONMENT=development
# Browser origins allowed to call the API with the session cookie (https only)
FRONTEND_ORIGINS=https://localhost:3000,https://127.0.0.1:3000
# Production example: FRONTEND_ORIGINS=https://tickorbit.in,https://www.tickorbit.in
FORCE_HTTPS=true
# true only behind a proxy that overwrites X-Forwarded-* (Vercel/Render/nginx)
TRUST_PROXY_HEADERS=false
