# ============================================================
# LastMinutePass — Environment Variables Configuration
# ============================================================

# Database (PostgreSQL / Local SQLite fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/lastminutepass
# DATABASE_URL=sqlite+aiosqlite:///./lastminutepass.db

# Caching & Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Security (JWT configuration)
SECRET_KEY=supersecretkeythatshouldbechangedinproduction12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 1 week

# Search Engine (MeiliSearch)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=meilimasterkey12345

# Third-party Integrations (Optional for local development)
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@lastminutepass.in
S3_BUCKET_NAME=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
