# LastMinutePass — environment configuration.
# Copy this file to `.env` in the same folder as docker-compose.yml and fill
# in real values. docker-compose reads it automatically. Keep `.env` out of git.

# === Domain ===
# Public hostname; must match your nginx-proxy VIRTUAL_HOST and your DNS record.
DOMAIN=your-domain.com

# === Database (PostgreSQL) ===
# Application database name.
POSTGRES_DB=lastminutepass
# Database username.
POSTGRES_USER=postgres
# Database password — use a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# === App secret ===
# Signs the JWT login tokens (HS256). Long random string; changing it logs
# every currently signed-in user out (they just log in again).
SECRET_KEY=change-me-to-a-long-random-value

# === MeiliSearch ===
# Admin/master key for the search engine. The backend and the meilisearch
# container must share the same value (docker-compose injects it into both).
MEILI_MASTER_KEY=change-me-to-a-long-random-value

# === HTTPS (Let's Encrypt) ===
# Contact email for TLS certificate notices. Only used if your nginx-proxy
# runs an acme-companion sidecar for auto-HTTPS.
LETSENCRYPT_EMAIL=you@example.com

# === Frontend -> backend base paths ===
# Same-origin path prefix the browser uses for API and WebSocket calls behind
# nginx. Keep as /api/v1 for the single-origin docker setup. Only use a full
# URL (e.g. https://api.example.com/api/v1) if the API is served from a
# genuinely different origin than the frontend.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=/api/v1

# === Email (Brevo / Sendinblue) ===
# Brevo v3 API key (~89 chars) from https://app.brevo.com/settings/keys/api.
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Sender address — must be a verified sender in Brevo, or on a verified domain.
BREVO_FROM_EMAIL=you@yourdomain.com
# Display name shown as the email sender.
EMAIL_FROM_NAME=LastMinutePass
