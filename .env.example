# Copy this file to `.env` in the same directory as docker-compose.yml and
# fill in real values. docker-compose.yml reads this automatically.

# === Domain ===
# Must exactly match the VIRTUAL_HOST your shared nginx-proxy expects, and
# what your DNS A record points at this server.
DOMAIN=tic.fe-zzz.com

# === Database ===
POSTGRES_DB=lastminutepass
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# === App secrets ===
# Must be a long random string in production — used to sign JWTs.
SECRET_KEY=change-me-to-a-long-random-value

# === MeiliSearch ===
MEILI_MASTER_KEY=change-me-to-a-long-random-value

# === HTTPS (only used if your nginx-proxy has an acme-companion sidecar) ===
LETSENCRYPT_EMAIL=you@example.com

# === SMS (MSG91) — optional, falls back to console/log mock if unset ===
MSG91_API_KEY=
MSG91_TEMPLATE_ID=

# === Email (SendGrid) — optional ===
SENDGRID_API_KEY=
EMAIL_FROM=noreply@tic.fe-zzz.com

# === Frontend API base (leave blank — see frontend/Dockerfile comment) ===
# Only set these if the API is deliberately served from a different origin
# than the frontend. Left blank, the app uses same-origin relative paths,
# which is correct for the single-nginx setup in docker-compose.yml.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
